# --- Contact form email delivery -------------------------------------------
# The site needs EXACTLY ONE of the two providers below.
# Resend is checked first; if RESEND_API_KEY is set it wins.
#
# Option A - Web3Forms (simplest, no domain verification needed)
#   1. Go to https://web3forms.com
#   2. Enter the inbox that should RECEIVE the messages
#   3. Confirm the email; copy the access key from the email you get
# WEB3FORMS_KEY and NEXT_PUBLIC_WEB3FORMS_KEY are accepted as aliases.
# NOTE: on Vercel, adding/changing an env var does NOT redeploy — trigger a
# redeploy (Deployments -> ... -> Redeploy) so the key reaches the running app.
WEB3FORMS_ACCESS_KEY=

# Option B - Resend (branded "from" address, routes each subject to its own inbox)
#   1. Sign up at https://resend.com
#   2. Verify your domain at https://resend.com/domains (required to send to
#      any address other than the one on your Resend account)
#   3. Create an API key with "Sending access"
RESEND_API_KEY=
# Must be an address on the domain you verified in Resend.
RESEND_FROM_EMAIL="Jade Anibor Foundation <hello@yourdomain.com>"

# --- Optional overrides -----------------------------------------------------
# Inboxes used by the form. Defaults match the addresses on the /contact page.
CONTACT_AUTHOR_EMAIL=Jadeanibor@icloud.com
CONTACT_FOUNDATION_EMAIL=Jadeaniborfoundation@gmail.com
CONTACT_CONSULTING_EMAIL=jfatrainingtools@gmail.com

# Send EVERY message to one inbox instead of routing by subject.
CONTACT_EMAIL_OVERRIDE=
